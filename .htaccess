# ─────────────────────────────────────────────────────────────
#  Café de Caro — cafedecaro.eniguala.com (Hostinger, sitio estático)
# ─────────────────────────────────────────────────────────────

Options -Indexes
ServerSignature Off
DirectoryIndex index.html

# ── Bloquear archivos que no deben ser públicos ──
# (por si se suben por error con el despliegue por Git)
<IfModule mod_alias.c>
  RedirectMatch 404 (^|/)\.git(/|$)
  RedirectMatch 404 (^|/)(tools|node_modules)(/|$)
</IfModule>
<FilesMatch "(^\.|\.(md|rules|log|pem|key|sh)$|^package(-lock)?\.json$|^serviceAccountKey.*\.json$)">
  Require all denied
</FilesMatch>

# ── Nombres anteriores de las páginas (marcadores y códigos QR viejos) ──
<IfModule mod_alias.c>
  RedirectMatch 301 ^(.*/)?kds-cocina\.html$ $1cocina.html
  RedirectMatch 301 ^(.*/)?admin-panel\.html$ $1admin.html
  RedirectMatch 301 ^(.*/)?admin-usuarios\.html$ $1admin.html
  RedirectMatch 301 ^(.*/)?inicial\.html$ $1index.html
</IfModule>

# HTTPS: actívalo en hPanel → Seguridad → SSL → "Forzar HTTPS"
# (hacerlo aquí además puede causar un bucle de redirecciones).

# ── Cabeceras de seguridad ──
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# ── Tipos MIME ──
AddType application/manifest+json .webmanifest
AddType application/javascript .js
AddType image/svg+xml .svg

# ── Caché ──
# HTML, CSS, JS y JSON se revalidan siempre (cambios visibles al publicar);
# el Service Worker se encarga de que la app cargue rápido.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|css|js|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "^sw\.js$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(png|svg|ico|webp|jpg|jpeg|woff2?)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

# ── Compresión ──
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/manifest+json image/svg+xml
</IfModule>
