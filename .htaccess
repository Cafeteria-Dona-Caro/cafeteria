# ─────────────────────────────────────────────────────────────
#  Café de Caro — cafedecaro.eniguala.com (Hostinger: PHP 8.3 + MariaDB)
#
#  /api/...   → api/router.php (ver api/.htaccess)
#  todo lo demás → carpeta public/ (páginas, css, js, imágenes)
#  config/, db/, README, .git… nunca se sirven.
# ─────────────────────────────────────────────────────────────

Options -Indexes
ServerSignature Off
DirectoryIndex index.html

# ── Nombres anteriores de las páginas (marcadores y códigos QR viejos) ──
<IfModule mod_alias.c>
  RedirectMatch 301 ^(.*/)?kds-cocina\.html$ $1cocina.html
  RedirectMatch 301 ^(.*/)?admin-panel\.html$ $1admin.html
  RedirectMatch 301 ^(.*/)?admin-usuarios\.html$ $1admin.html
  RedirectMatch 301 ^(.*/)?inicial\.html$ $1index.html
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Forzar HTTPS: mejor activarlo en hPanel → Seguridad → SSL → "Forzar HTTPS".
  # Si hiciera falta aquí, descomentar (verificar que no cause un bucle):
  # RewriteCond %{HTTPS} off
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # API: la maneja api/.htaccess
  RewriteRule ^api(/|$) - [L]

  # Raíz → página de inicio
  RewriteRule ^$ public/index.html [L]

  # Todo lo demás se busca dentro de public/ (una sola vez)
  RewriteCond $1 !^public/
  RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Doble seguro por si el rewrite no estuviera activo
<FilesMatch "(^\.|\.(md|sql|log|pem|key|sh|bak)$|^config.*\.php$)">
  Require all denied
</FilesMatch>

# ── Cabeceras de seguridad ──
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000"
  # Solo recursos del propio sitio: sin scripts en línea ni de terceros (freno extra contra XSS)
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
</IfModule>

# ── Tipos MIME ──
AddType application/javascript .js
AddType image/svg+xml .svg
AddType font/woff2 .woff2

# ── Caché ──
# HTML, CSS, JS y JSON se revalidan siempre (los cambios se ven al publicar).
<IfModule mod_headers.c>
  <FilesMatch "\.(html|css|js|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "^sw\.js$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(png|svg|ico|webp|jpg|jpeg|woff2)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
</IfModule>

# ── Compresión (NO se comprime text/event-stream: rompería el tiempo real) ──
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
