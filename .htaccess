# ─────────────────────────────────────────────────────────────
#  Café de Caro — cafedecaro.eniguala.com (Hostinger: PHP + MySQL)
# ─────────────────────────────────────────────────────────────

Options -Indexes
ServerSignature Off
DirectoryIndex index.html

# ── Bloquear archivos que no deben ser públicos ──
# (la API tiene además su propio api/.htaccess)
<IfModule mod_alias.c>
  RedirectMatch 404 (^|/)\.git(/|$)
  RedirectMatch 404 (^|/)(node_modules|tools)(/|$)
</IfModule>
<FilesMatch "(^\.|\.(md|sql|log|pem|key|sh|bak|rules)$|^package(-lock)?\.json$)">
  Require all denied
</FilesMatch>

# ── Nombres anteriores de las páginas (marcadores y códigos QR viejos) ──
<IfModule mod_alias.c>
  RedirectMatch 301 ^(.*/)?kds-cocina\.html$ $1cocina.html
  RedirectMatch 301 ^(.*/)?admin-panel\.html$ $1admin.html
  RedirectMatch 301 ^(.*/)?admin-usuarios\.html$ $1admin.html
  RedirectMatch 301 ^(.*/)?inicial\.html$ $1index.html
</IfModule>

# HTTPS: actívalo en hPanel → Seguridad → SSL → "Forzar HTTPS"
# (hacerlo aquí además puede causar un bucle de redirecciones).

# ── Cabeceras de seguridad ──
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000"
  # Solo se ejecutan scripts del propio sitio (ningún script en línea): freno extra contra XSS
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
</IfModule>

# ── Tipos MIME ──
AddType application/javascript .js
AddType image/svg+xml .svg

# ── Caché ──
# HTML, CSS, JS y JSON se revalidan siempre (los cambios se ven al publicar).
<IfModule mod_headers.c>
  <FilesMatch "\.(html|css|js|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "^sw\.js$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(png|svg|ico|webp|jpg|jpeg|woff2?)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

# ── Compresión ──
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
